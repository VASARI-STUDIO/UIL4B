# Firebase Configuration
# Get these values from your Firebase Console > Project Settings
# IMPORTANT: Set Firestore region to australia-southeast1 (Sydney)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Google Fonts WebFonts API key
# Public client-side key — restrict by HTTP referrer (uil4b.com/*) in Google Cloud Console
# Get one at https://developers.google.com/fonts/docs/developer_api
VITE_GOOGLE_FONTS_API_KEY=your_google_fonts_key_here

# Google OAuth 2.0 Web client ID (public, not secret)
# Used for Firebase Google sign-in popup + Google Identity Services One Tap.
# Authorised JavaScript origins must include your domain (https://uil4b.com).
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
