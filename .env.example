# --- Client-side (Vite, VITE_ prefix) ---

# Firebase web app configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Google Fonts API key (optional)
VITE_GOOGLE_FONTS_API_KEY=your_google_fonts_key_here

# Google OAuth web client ID
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Stripe publishable key
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key

# --- Server-side (no prefix) ---

# Google Fonts API key for the fonts proxy (optional)
# GOOGLE_FONTS_API_KEY=...

# OpenRouter API key, model override (optional) and referer URL (optional)
# OPENROUTER_API_KEY=...
# OPENROUTER_MODEL=...
# OPENROUTER_SITE_URL=https://uil4b.com

# Gemini API key (also accepted as GOOGLE_GENERATIVE_AI_API_KEY or GOOGLE_API_KEY)
# GEMINI_API_KEY=...

# Administrator email addresses, comma-separated
# ADMIN_EMAILS=you@example.com

# Salt for rate-limit keys; any long random string
# RATE_LIMIT_SALT=...

# Firebase Admin service account key, as a single-line JSON string
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Stripe secret key, webhook signing secret and price IDs
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...
