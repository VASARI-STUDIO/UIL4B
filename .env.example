# Firebase Configuration
# Get these values from your Firebase Console > Project Settings
# IMPORTANT: Set Firestore region to australia-southeast1 (Sydney)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Google Fonts WebFonts API key (OPTIONAL)
# Public client-side key — restrict by HTTP referrer (uil4b.com/*) in Google Cloud Console
# Get one at https://developers.google.com/fonts/docs/developer_api
# If unset, the app falls back to the /api/fonts proxy which needs no key.
VITE_GOOGLE_FONTS_API_KEY=your_google_fonts_key_here

# Google OAuth 2.0 Web client ID (public, not secret)
# Used for Firebase Google sign-in popup + Google Identity Services One Tap.
# Authorised JavaScript origins must include your domain (https://uil4b.com).
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Stripe publishable key (public, not secret) — required for embedded checkout.
# Used client-side by /checkout to mount Stripe's <EmbeddedCheckout />.
# Get it from https://dashboard.stripe.com/apikeys (starts with pk_live_ / pk_test_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key

# --- Server-side env vars (set in Vercel, NOT prefixed with VITE_) ---

# Google Fonts API key for the /api/fonts proxy (OPTIONAL)
# If unset, the proxy uses Google's keyless metadata endpoint instead.
# GOOGLE_FONTS_API_KEY=...

# OpenRouter API key — primary AI provider for the AI Prompt Generator tool
# Get one at https://openrouter.ai/keys (key starts with sk-or-...)
# OPENROUTER_API_KEY=sk-or-...
# Optional: override the model (default deepseek/deepseek-chat). Any OpenRouter model id.
# OPENROUTER_MODEL=deepseek/deepseek-chat
# Optional: attribution URL sent as HTTP-Referer (defaults to https://uil4b.com)
# OPENROUTER_SITE_URL=https://uil4b.com

# Gemini API key — required for AI tools (Alt Text Generator uses Gemini 2.5 Flash)
# Get one at https://aistudio.google.com/apikey
# Accepted names: GEMINI_API_KEY, GOOGLE_GENERATIVE_AI_API_KEY, or GOOGLE_API_KEY
# GEMINI_API_KEY=...

# Administrator allowlist — REQUIRED, or nobody is an administrator
# Comma-separated email addresses, compared lowercase against a VERIFIED
# Firebase ID token (api/_lib/adminEmails.js). These accounts get /admin, the
# full user list, the moderator roster and Pro without a subscription.
# This used to be a literal in api/_lib/admin.js and api/_lib/plans.js — the
# founder's personal address, in tracked source, in a public repository, naming
# the one account worth phishing. It is configuration now.
# IT FAILS CLOSED. Unset or empty grants admin to NOBODY, never to everybody,
# so /admin and /api/verify-admin recognise no one until this is set in Vercel
# (Project → Settings → Environment Variables, all environments).
# A verified email is still required, so an address nobody can receive mail at
# cannot be claimed by signing up with it.
# ADMIN_EMAILS=you@example.com
# ADMIN_EMAILS=you@example.com,cofounder@example.com

# Rate-limiter salt — SET THIS IN PRODUCTION
# api/_lib/rateLimit.js keys its Firestore counter documents by SHA-256 of
# `salt:ip`, so nothing in the database identifies anyone. The salt is what makes
# that true: the whole IPv4 space is only 4.3 billion hashes, so a salt an
# attacker knows is no salt at all.
# UNSET IS NOT FATAL AND NOT FREE. Each serverless instance generates its own
# random salt at startup and logs a warning, so the hashes stay unreversible but
# stop being comparable between instances — counters are no longer shared and the
# limits are effectively multiplied by the instance count.
# Any long random string; rotating it just resets the current windows.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# RATE_LIMIT_SALT=...

# Firebase Admin service account key (JSON string)
# Required for verifyIdToken in serverless functions
# Download from Firebase Console > Project Settings > Service Accounts > Generate new private key
# Paste the entire JSON as a single-line string in Vercel
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...",...}

# Stripe — required for the Pro subscription checkout
# 1. Get your secret key from https://dashboard.stripe.com/apikeys
# 2. Create the product + prices: STRIPE_SECRET_KEY=sk_... npm run setup:stripe
#    (the script prints the price IDs to paste below)
# 3. Add the webhook (events: checkout.session.completed, customer.subscription.*)
#    at https://dashboard.stripe.com/webhooks → endpoint /api/stripe-webhook
# Yearly plans include a 7-day free trial (applied at checkout, no config needed).
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...
