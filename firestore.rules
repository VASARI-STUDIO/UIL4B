rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Billing/entitlement fields on a user doc. These decide whether the server
    // hands out Pro (api/_lib/plans.js → planForUser reads `subscription` and
    // `lifetimeEntitlement` straight off this doc), so a client that could write
    // them could grant itself Pro and bill the founder for the AI calls.
    // Only the Stripe webhook / checkout reconciliation may set them, and those
    // run through the Firebase Admin SDK, which bypasses these rules entirely.
    function lockedUserFields() {
      return ['lifetimeEntitlement', 'subscription', 'stripeCustomerId'];
    }

    // Create path: the incoming document must not carry any locked field.
    function createsNoLockedField() {
      return !request.resource.data.keys().hasAny(lockedUserFields());
    }

    // Update path: `request.resource.data` is the POST-merge document, so
    // diffing against `resource.data` catches added, changed AND deleted locked
    // fields — including ones smuggled in via setDoc(..., { merge: true }).
    function leavesLockedFieldsUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(lockedUserFields());
    }

    // User profiles — only the owner can read/write, and never the billing fields
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow read: if isOwner();
      allow create: if isOwner() && createsNoLockedField();
      allow update: if isOwner() && leavesLockedFieldsUntouched();
      // Real account deletion now runs server-side (api/delete-account.js) with
      // the Admin SDK, because it also has to cancel Stripe and reach the sync
      // subcollection, which a client rule can never delete with its parent.
      //
      // This permission is kept anyway: dropping your own profile can only ever
      // lose you access, never grant it — every entitlement path re-verifies a
      // paid Stripe session server-side — and it leaves the owner a way to
      // clear their own document if the endpoint is ever unavailable.
      allow delete: if isOwner();

      // Sync data subcollection — only the owner
      match /sync/{docId} {
        allow read, write: if isOwner();
      }
    }

    // Feedback — anyone can create, only admin can read/update/delete
    match /feedback/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null
        && request.auth.token.admin == true;
    }

    // Community prompts — signed-in users can create, admin can manage
    match /community-prompts/{promptId} {
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if request.auth != null;
      allow update, delete: if request.auth != null
        && request.auth.token.admin == true;
    }

    // Community submissions — the shared review queue for gradients, designs
    // and palettes (utils/communityQueue.js).
    //
    // WHY IT EXISTS: those submissions were localStorage-only. A user who
    // submitted on one browser saw nothing on another, and no admin could ever
    // review them — "pending" described a review that could not happen.
    //
    // Same shape as community-prompts, with one addition: the owner may
    // withdraw their own submission. That is the one write a non-admin has a
    // legitimate reason to make after creating it, and it can only ever remove
    // something from the queue, never promote it.
    match /community-submissions/{submissionId} {
      function isSignedIn() { return request.auth != null; }
      function isAdmin() { return isSignedIn() && request.auth.token.admin == true; }
      function isOwner() { return isSignedIn() && resource.data.authorUid == request.auth.uid; }

      // A client may only ever create its OWN submission, and only as
      // 'pending'. 'approved' is a reviewer's word — reachable from nowhere on
      // the client, so nothing can put itself in the library.
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.status == 'pending';

      allow read: if isSignedIn();

      // Reviewers decide. This is the write that never worked: the `admin`
      // claim was gated on here and NOTHING in the codebase ever called
      // setCustomUserClaims, so every moderation write was rejected.
      // api/verify-admin.js now grants it, from a server-verified email.
      allow update: if isAdmin()
        || (isOwner() && request.resource.data.status == 'withdrawn'
            && request.resource.data.authorUid == resource.data.authorUid);

      allow delete: if isAdmin() || isOwner();
    }

    // Aggregate usage analytics — per-day counter docs ({YYYY-MM-DD}).
    // Any signed-in user may create/update (increment) the counters so the
    // admin dashboard can reflect ALL users' usage. Read is gated to the owner
    // email (the Firebase `admin` custom claim is never set in this project).
    // Note: this cannot fully prevent a signed-in user inflating counters —
    // accepted limitation for an internal, non-billing dashboard.
    match /analytics-daily/{day} {
      allow read: if request.auth != null && request.auth.token.email == 'dylanjacob1100@gmail.com';
      allow create, update: if request.auth != null;
    }
  }
}
