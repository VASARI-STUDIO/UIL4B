+      // The elements of the two payload lists. A rule cannot loop, so each
+      // index up to the 32-entry list cap is checked on its own, and an index
+      // past the end of a shorter list passes. A gradient stop is the
+      // { color, position } pair gradientSubmissions.js sanitises to; a palette
+      // colour is a hex string.
+      function stopAt(i) {
+        let stops = request.resource.data.payload.stops;
+        return stops.size() <= i
+          || (stops[i] is map
+              && stops[i].keys().hasOnly(['color', 'position'])
+              && stops[i].color is string
+              && stops[i].color.size() <= 16
+              && stops[i].position is number);
+      }
+
+      function colorAt(i) {
+        let colors = request.resource.data.payload.colors;
+        return colors.size() <= i
+          || (colors[i] is string && colors[i].size() <= 32);
+      }
+
+      // Without these, `angle` took any type and `stops` and `colors` took any
+      // elements, so a document could still reach 1 MiB inside the list caps.
+      function payloadElementsOk() {
+        return (!('angle' in request.resource.data.payload)
+                || request.resource.data.payload.angle is number)
+          && (!('stops' in request.resource.data.payload)
