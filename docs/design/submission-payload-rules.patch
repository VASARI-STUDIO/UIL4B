+                  && stopAt(24) && stopAt(25) && stopAt(26) && stopAt(27) && stopAt(28) && stopAt(29) && stopAt(30) && stopAt(31)))
+          && (!('colors' in request.resource.data.payload)
+              || (
+                  colorAt(0) && colorAt(1) && colorAt(2) && colorAt(3) && colorAt(4) && colorAt(5) && colorAt(6) && colorAt(7)
+                  && colorAt(8) && colorAt(9) && colorAt(10) && colorAt(11) && colorAt(12) && colorAt(13) && colorAt(14) && colorAt(15)
+                  && colorAt(16) && colorAt(17) && colorAt(18) && colorAt(19) && colorAt(20) && colorAt(21) && colorAt(22) && colorAt(23)
+                  && colorAt(24) && colorAt(25) && colorAt(26) && colorAt(27) && colorAt(28) && colorAt(29) && colorAt(30) && colorAt(31)));
