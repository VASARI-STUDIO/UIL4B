 // Cross-user data for the admin Users tab. `users/{uid}` is owner-only in the
 // Firestore rules, so it is read here with the Admin SDK and returned only to a
 // caller that passed the verified-admin check.
+// Profile fields are written by the signed-in user, so a value here may be any
+// type. The Admin users table renders these as React children, and an object
+// or array in one makes the whole page throw. Anything that is not a string
+// becomes empty, and a string is cut to the cap the rules enforce.
+function profileText(value, max) {
+  return typeof value === 'string' ? value.slice(0, max) : ''
+}
