+    // A community post (a prompt or a submission) must come with a write, in the
+    // same batch, to the poster's counter document users/{uid}/limits/community,
+    // and that write must name this post. The counter's own rule (below) holds
+    // the 30-second gap and the daily caps; this only ties the post to it.
+    // `lastId` names one document, so one counter write cannot cover two posts
+    // in a batch. getAfter() reads the counter as the batch leaves it.
+    function postLimitsOk(kind, id) {
+      let c = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/limits/community).data;
+      return c.lastAt == request.time && c.lastKind == kind && c.lastId == id;
+    }
+
     // User profiles — only the owner can read/write, and never the billing fields
