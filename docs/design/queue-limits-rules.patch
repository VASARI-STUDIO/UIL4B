+
+      // The community-post counter (see postLimitsOk). One document, written
+      // with each post: when the last post was, which one it was, and how many
+      // prompts and submissions the account has sent in the current 24-hour
+      // window. The window starts at the first post and restarts, on a server
+      // time, only once 24 hours have passed. No delete.
+      match /limits/{docId} {
+        // No lower bound is checked: counterStartOk and counterStepOk keep both
+        // counts at 0, 1 or the stored count plus 0 or 1, so neither goes below zero.
+        function counterShapeOk() {
+          let a = request.resource.data;
+          return docId == 'community'
+            && a.size() == 6
+            && a.lastAt == request.time
+            && a.lastKind in ['prompt', 'submission']
+            && a.lastId is string && a.lastId.size() <= 200
+            && a.prompts is int && a.prompts <= 10
+            && a.submissions is int && a.submissions <= 10;
+        }
+
+        // The first post: a new window, and this post is the only one in it.
+        function counterStartOk() {
+          let a = request.resource.data;
+          return a.windowStart == request.time
+            && a.prompts == (a.lastKind == 'prompt' ? 1 : 0)
+            && a.submissions == (a.lastKind == 'prompt' ? 0 : 1);
+        }
+
+        // A later post: 30 seconds after the last, and either one more in the
+        // same window (still inside 24 hours of its start) or a new window of
+        // one once the 24 hours are over. The other kind's count is untouched
+        // inside a window and zero in a new one.
+        function counterStepOk() {
+          let a = request.resource.data;
+          let b = resource.data;
+          let p = a.lastKind == 'prompt';
+          return request.time > b.lastAt + duration.value(30, 's')
+            && (a.windowStart == b.windowStart
+                ? (request.time < b.windowStart + duration.value(1, 'd')
+                   && a.prompts == b.prompts + (p ? 1 : 0)
+                   && a.submissions == b.submissions + (p ? 0 : 1))
+                : (a.windowStart == request.time
+                   && request.time >= b.windowStart + duration.value(1, 'd')
+                   && a.prompts == (p ? 1 : 0)
+                   && a.submissions == (p ? 0 : 1)));
+        }
+
+        allow read: if isOwner();
+        allow create: if isOwner() && counterShapeOk() && counterStartOk();
+        allow update: if isOwner() && counterShapeOk() && counterStepOk();
+      }
     }
 
