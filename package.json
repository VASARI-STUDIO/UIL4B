{
  "name": "uil4b-design-toolkit",
  "private": true,
  "version": "2.8.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "setup:stripe": "node scripts/setup-stripe.js",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:rules": "firebase emulators:exec --project demo-uil4b --only firestore \"node --test tests/rules/**/*.test.js\"",
    "test:users": "vite build --mode test && node scripts/prerender.mjs && playwright test",
    "test:users:report": "node tests/user-sim/summarize.js",
    "prerender": "node scripts/prerender.mjs",
    "sync:rewrites": "node scripts/sync-vercel-rewrites.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.6",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "@stripe/react-stripe-js": "^6.6.0",
    "@stripe/stripe-js": "^9.8.0",
    "@vercel/analytics": "^2.0.1",
    "firebase": "^11.9.0",
    "firebase-admin": "^13.0.0",
    "gsap": "^3.15.0",
    "jszip": "^3.10.1",
    "lenis": "^1.3.25",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.9.0",
    "stripe": "^22.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^14.27.0",
    "globals": "^17.4.0",
    "vite": "^8.0.1"
  }
}
