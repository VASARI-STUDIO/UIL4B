{
  "name": "uil4b-design-toolkit",
  "private": true,
  "version": "2.8.1",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "predev": "node scripts/fetch-switzer.mjs --soft",
    "dev": "vite",
    "fonts:fetch": "node scripts/fetch-switzer.mjs",
    "prebuild": "node scripts/fetch-switzer.mjs",
    "build": "vite build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "apply:gated": "node scripts/apply-gated-patches.mjs",
    "preview": "vite preview",
    "setup:stripe": "node scripts/setup-stripe.js",
    "pretest:unit": "node scripts/fetch-switzer.mjs",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:rules": "firebase emulators:exec --project demo-uil4b --only firestore,storage \"node --test tests/rules/**/*.test.js\"",
    "test:users": "node scripts/fetch-switzer.mjs && vite build --mode test && node scripts/prerender.mjs && playwright test",
    "test:users:report": "node tests/user-sim/summarize.js",
    "prerender": "node scripts/prerender.mjs",
    "og:cards": "node scripts/og-cards.mjs",
    "auth-wall:generate": "node scripts/auth-wall/generate.mjs",
    "home-exports:generate": "node scripts/home-exports/generate.mjs",
    "tools:shots": "node scripts/tool-shots.mjs",
    "sync:rewrites": "node scripts/sync-vercel-rewrites.mjs",
    "sync:sitemap": "node scripts/sync-sitemap.mjs",
    "sync:llms": "node scripts/llms-txt.mjs",
    "sync:credits": "node scripts/sync-credits.mjs",
    "design:md": "node scripts/design-md.mjs",
    "icons:ico": "node scripts/favicon-ico.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.6",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "@stripe/react-stripe-js": "^6.6.0",
    "@stripe/stripe-js": "^9.8.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.10.0",
    "firebase": "^11.9.0",
    "firebase-admin": "^13.0.0",
    "gsap": "^3.15.0",
    "jszip": "^3.10.1",
    "lenis": "^1.3.25",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.9.0",
    "stripe": "^22.2.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.34.1",
    "globals": "^17.4.0",
    "vite": "^8.0.1"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "zod": "^4.6.7"
  }
}
