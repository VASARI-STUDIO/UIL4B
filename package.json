{
  "name": "uil4b-design-toolkit",
  "private": true,
  "version": "2.8.1",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "predev": "node scripts/fetch-switzer.mjs --soft",
    "dev": "vite",
    "fonts:fetch": "node scripts/fetch-switzer.mjs",
    "prebuild": "node scripts/fetch-switzer.mjs && node scripts/fetch-pro-data.mjs",
    "build": "vite build && node scripts/prerender.mjs && node scripts/check-no-test-session.mjs",
    "lint": "eslint .",
    "themes:smoke": "node scripts/export-themes-smoke.mjs",
    "themes:check": "node scripts/export-themes-check.mjs",
    "themes:sweep": "node scripts/export-themes-sweep.mjs",
    "apply:gated": "node scripts/apply-gated-patches.mjs",
    "preview": "vite preview",
    "setup:stripe": "node scripts/setup-stripe.js",
    "pretest:unit": "node scripts/fetch-switzer.mjs",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:rules": "firebase emulators:exec --project demo-uil4b --only firestore,storage \"node --test --test-concurrency=1 tests/rules/**/*.test.js\"",
    "test:users": "node scripts/fetch-switzer.mjs && node scripts/fetch-pro-data.mjs && vite build --mode test && node scripts/prerender.mjs && playwright test",
    "test:users:report": "node tests/user-sim/summarize.js",
    "prerender": "node scripts/prerender.mjs",
    "og:cards": "node scripts/og-cards.mjs",
    "og:home": "node scripts/render-home-og.mjs",
    "auth-wall:generate": "node scripts/auth-wall/generate.mjs",
    "tools:shots": "node scripts/tool-shots.mjs",
    "sync:rewrites": "node scripts/sync-vercel-rewrites.mjs",
    "sync:sitemap": "node scripts/sync-sitemap.mjs",
    "sync:llms": "node scripts/llms-txt.mjs",
    "sync:credits": "node scripts/sync-credits.mjs",
    "sync:fonts": "node scripts/sync-font-catalogue.mjs",
    "design:md": "node scripts/design-md.mjs",
    "icons:ico": "node scripts/favicon-ico.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.6",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "@stripe/react-stripe-js": "^7.0.1",
    "@stripe/stripe-js": "^10.2.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.11.0",
    "firebase": "^13.2.0",
    "firebase-admin": "^13.0.0",
    "gsap": "^3.15.1",
    "jszip": "^3.10.1",
    "lenis": "^1.3.27",
    "opentype.js": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "stripe": "^22.2.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-tools": "^15.35.0",
    "globals": "^17.14.0",
    "vite": "^8.3.6"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "zod": "^4.6.7",
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.6"
    }
  }
}
